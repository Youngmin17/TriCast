{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TriCast EmulationRequest",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "evaluate",
        "compare",
        "sweep",
        "explain",
        "inspect",
        "report"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RecipeChoice"
      }
    },
    "sweep": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "axis": {
          "type": "string",
          "enum": [
            "f_bits",
            "chunk_size",
            "g_bits",
            "c_mode",
            "group_size"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "axis",
        "values"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "wikitext2_ppl",
          "hellaswag",
          "coqa",
          "arc_easy",
          "arc_challenge",
          "piqa",
          "winogrande",
          "lambada_openai"
        ]
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_windows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "limit": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "max_windows",
        "limit"
      ],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topic": {
      "type": [
        "string",
        "null"
      ]
    },
    "evaluation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "seqlen": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "seqlen",
        "seed"
      ],
      "additionalProperties": false
    },
    "report_inputs": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "texts": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        },
        "input_ids": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 65536,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "texts",
        "input_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "intent",
    "model",
    "recipes",
    "sweep",
    "tasks",
    "limits",
    "assumptions",
    "questions",
    "topic",
    "evaluation",
    "report_inputs"
  ],
  "additionalProperties": false,
  "$defs": {
    "QuantChoice": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "scheme": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "mxfp8_e4m3",
            "mxfp8_e5m2",
            "mxfp6_e3m2",
            "mxfp6_e2m3",
            "mxfp4",
            "mxint8",
            "mxint4",
            "nvfp4",
            "nvfp4_4o6",
            "msfp12",
            "msfp16",
            "fp8_tensor",
            "fp8_tensor_ema",
            "fp8_tensor_delayed",
            "fp8_row",
            "fp8_group128",
            "fp8_block128",
            "int8_tensor",
            "int8_row",
            "int4_g128",
            "int4_g128_zp",
            "kivi2",
            "kivi4",
            "bf16",
            "fp16",
            "fp32",
            "tf32",
            null
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ],
          "description": "Registered format name or get_format syntax: intN, uintN, eXmY[:opts]."
        },
        "granularity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "tensor",
            "row",
            "group",
            "block",
            null
          ]
        },
        "group_size": {
          "type": [
            "integer",
            "null"
          ]
        },
        "scale_format": {
          "type": [
            "string",
            "null"
          ],
          "description": "Registered format name or get_format syntax: intN, uintN, eXmY[:opts]."
        },
        "scale_method": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "absmax",
            "pow2_floor",
            "pow2_ceil",
            "mse",
            "percentile",
            null
          ]
        },
        "rounding": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "rne",
            "rna",
            "rtz",
            "rup",
            "rdn",
            "sr",
            null
          ]
        },
        "zero_point": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "none",
            "int",
            "float",
            null
          ]
        },
        "observer": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "minmax",
            "ema",
            "history",
            "percentile",
            "mse",
            null
          ]
        },
        "scale_rounding": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "rne",
            "rna",
            "rtz",
            "rup",
            "rdn",
            "sr",
            null
          ]
        }
      },
      "required": [
        "scheme",
        "format",
        "granularity",
        "group_size",
        "scale_format",
        "scale_method",
        "rounding",
        "zero_point",
        "observer",
        "scale_rounding"
      ],
      "additionalProperties": false
    },
    "MMAChoice": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "preset": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "nvidia_ada_fp8",
            "nvidia_hopper_fp8",
            "nvidia_blackwell_fp8",
            "nvidia_blackwell_fp4",
            "deepseek_fp8_promote128",
            "fp32_fma",
            "fp64",
            "int_exact",
            null
          ]
        },
        "algorithm": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "cofda",
            "gdfs",
            "fp32_fma",
            "fp64",
            "int_exact",
            null
          ]
        },
        "f_bits": {
          "type": [
            "integer",
            "null"
          ]
        },
        "chunk_size": {
          "type": [
            "integer",
            "null"
          ]
        },
        "c_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "fused",
            "decoupled",
            null
          ]
        },
        "g_bits": {
          "type": [
            "integer",
            "null"
          ]
        },
        "group_size": {
          "type": [
            "integer",
            "null"
          ]
        },
        "promote_interval": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "preset",
        "algorithm",
        "f_bits",
        "chunk_size",
        "c_mode",
        "g_bits",
        "group_size",
        "promote_interval"
      ],
      "additionalProperties": false
    },
    "RecipeChoice": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "weight": {
          "$ref": "#/$defs/QuantChoice"
        },
        "activation": {
          "$ref": "#/$defs/QuantChoice"
        },
        "mma": {
          "$ref": "#/$defs/MMAChoice"
        },
        "transform": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "none",
            "hadamard",
            "random_hadamard",
            "smoothquant",
            "awq",
            null
          ]
        },
        "weight_algo": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "rtn",
            "gptq",
            null
          ]
        },
        "kv": {
          "$ref": "#/$defs/KVChoice"
        },
        "calibration": {
          "$ref": "#/$defs/CalibrationChoice"
        },
        "layers": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "modules": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "skip": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "base",
        "weight",
        "activation",
        "mma",
        "transform",
        "weight_algo",
        "kv",
        "calibration",
        "layers",
        "modules",
        "skip"
      ],
      "additionalProperties": false
    },
    "KVChoice": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "preset": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "kivi2",
            "kivi4",
            "kv_fp8",
            null
          ]
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "cache",
            "fakequant",
            null
          ]
        },
        "residual": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "preset",
        "mode",
        "residual"
      ],
      "additionalProperties": false
    },
    "CalibrationChoice": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "dataset": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "samples": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "seqlen": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sequential": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "dataset",
        "samples",
        "seqlen",
        "seed",
        "sequential"
      ],
      "additionalProperties": false
    }
  }
}
